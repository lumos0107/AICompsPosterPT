@@ -204,7 +204,8 @@ public class LoopV2Engine {
         double eu = u.getElevationMeters() == null ? 0.0 : u.getElevationMeters();
         double ev = v.getElevationMeters() == null ? eu : v.getElevationMeters();
         return pref.edgeCost(len, eu, ev, attrs.facilityMeters(u.getPointId()), attrs.facilityMeters(v.getPointId()),
-            attrs.isSignal(v.getPointId()));
+            attrs.isSignal(v.getPointId()), attrs.isLit(u.getPointId()), attrs.isLit(v.getPointId()),
+            attrs.waterMeters(u.getPointId()), attrs.waterMeters(v.getPointId()));
     }
 
     /** 방문 목록 끝에서부터 경로 길이 limit(m) 안에 드는 점의 개수(현재 노드 포함). */
diff --git a/src/main/java/com/gildongmu/algorithm/loopv2/NodeAttributes.java b/src/main/java/com/gildongmu/algorithm/loopv2/NodeAttributes.java
index 24e3c13..95e854b 100644
--- a/src/main/java/com/gildongmu/algorithm/loopv2/NodeAttributes.java
+++ b/src/main/java/com/gildongmu/algorithm/loopv2/NodeAttributes.java
@@ -29,6 +29,9 @@ public class NodeAttributes {
 
     private final Set<Integer> signals = new HashSet<>();
     private final Map<Integer, Double> facility = new HashMap<>();
+    // 2026-11-10 밤 추가(선택 열): lit(25 m 안 조명 0/1), water_m(해안·하천까지 m). 열이 없으면 조명 있음·물가로 보아 비용 0.
+    private final Set<Integer> dark = new HashSet<>();
+    private final Map<Integer, Double> water = new HashMap<>();
     private final boolean loaded;
 
     @Autowired   // 테스트용 생성자가 따로 있어 Spring이 쓸 생성자를 지정
@@ -58,6 +61,16 @@ public class NodeAttributes {
         return facility.getOrDefault(pointId, Preference.FACILITY_CAP_METERS);
     }
 
+    /** 25 m 안에 조명이 있으면 true(열이 없으면 true). */
+    public boolean isLit(int pointId) {
+        return !dark.contains(pointId);
+    }
+
+    /** 해안·하천까지 거리(m). 열이 없으면 0(물가로 봄). */
+    public double waterMeters(int pointId) {
+        return water.getOrDefault(pointId, 0.0);
+    }
+
     private void read(Path p) {
         try {
             List<String> lines = Files.readAllLines(p, StandardCharsets.UTF_8);
@@ -68,6 +81,8 @@ public class NodeAttributes {
                 int id = Integer.parseInt(v[0].strip());
                 if ("1".equals(v[1].strip())) signals.add(id);
                 facility.put(id, Double.parseDouble(v[2].strip()));
+                if (v.length > 3 && "0".equals(v[3].strip())) dark.add(id);
+                if (v.length > 4) water.put(id, Double.parseDouble(v[4].strip()));
             }
         } catch (IOException e) {
             throw new UncheckedIOException("노드 속성 파일을 읽지 못함: " + p, e);
diff --git a/src/main/java/com/gildongmu/algorithm/loopv2/Preference.java b/src/main/java/com/gildongmu/algorithm/loopv2/Preference.java
index c573889..844e9e9 100644
--- a/src/main/java/com/gildongmu/algorithm/loopv2/Preference.java
+++ b/src/main/java/com/gildongmu/algorithm/loopv2/Preference.java
@@ -1,16 +1,18 @@
 /*
  * Preference (정보기술학회 실험, 2026-11-10)
- * - 러너 선호 α = (α_s 경사, α_c 신호 교차로, α_f 편의시설). 0이면 그 선호를 고려하지 않는다.
+ * - 러너 선호 α = (α_s 경사, α_c 신호 교차로, α_f 편의시설, α_l 조명, α_w 물가). 0이면 그 선호를 고려하지 않는다.
+ *   조명·물가는 2026-11-10 밤 추가(러너 선호 문헌: 밝은 길, 물가·녹지 선호). 둘 다 0이면 기존과 같다.
  * - 계획서 2장의 비용 단위:
- *     경사·편의시설 = 구간 길이에 비례, 신호 교차로 = 통과 1회당(길이 곱과 분리).
+ *     경사·편의시설·조명·물가 = 구간 길이에 비례, 신호 교차로 = 통과 1회당(길이 곱과 분리).
  * - 아래 상수는 2026-11-10 본 실험 전에 확정한 값이다(근거: 정보기술학회/실험/코드수정_1110/수식대조.md 3장).
- *   예비 경로나 본 실험 결과를 보고 바꾼 값이 아니다.
+ *   예비 경로나 본 실험 결과를 보고 바꾼 값이 아니다. 물가 반경 50 m는 조명·물가를 추가하면서 정한 값이다.
  */
 package com.gildongmu.algorithm.loopv2;
 
 public record Preference(double alphaS, double alphaC, double alphaF,
                          double tauPercent, double signalPassMeters, double facilityCapMeters,
-                         double lambdaP, double stepMeters, double reuseRecentMeters) {
+                         double lambdaP, double stepMeters, double reuseRecentMeters,
+                         double alphaL, double alphaW, double waterNearMeters) {
 
     /** 경사 면제 임계값 τ(%) 확정값. */
     public static final double TAU_PERCENT = 2.0;
@@ -24,10 +26,16 @@ public record Preference(double alphaS, double alphaC, double alphaF,
     public static final double STEP_METERS = 15.0;
     /** 재사용 판정에서 뺄 최근 경로 길이(m). 지나온 길 중 이 길이 안의 점은 '재사용'으로 세지 않는다. */
     public static final double REUSE_RECENT_METERS = 100.0;
+    /** 물가로 보는 해안·하천까지 거리(m). */
+    public static final double WATER_NEAR_METERS = 50.0;
 
     public static Preference of(double alphaS, double alphaC, double alphaF) {
+        return of(alphaS, alphaC, alphaF, 0.0, 0.0);
+    }
+
+    public static Preference of(double alphaS, double alphaC, double alphaF, double alphaL, double alphaW) {
         return new Preference(alphaS, alphaC, alphaF, TAU_PERCENT, SIGNAL_PASS_METERS, FACILITY_CAP_METERS,
-            LAMBDA_P, STEP_METERS, REUSE_RECENT_METERS);
+            LAMBDA_P, STEP_METERS, REUSE_RECENT_METERS, alphaL, alphaW, WATER_NEAR_METERS);
     }
 
     /** 경사 항 f_s: min(1, max(0, |g| − τ) / 20), g = 구간 경사(%). */
@@ -42,12 +50,30 @@ public record Preference(double alphaS, double alphaC, double alphaF,
         return (Math.min(facU, facilityCapMeters) + Math.min(facV, facilityCapMeters)) / 2.0 / facilityCapMeters;
     }
 
+    /** 조명 항 f_l: 두 끝 노드 중 25 m 안에 조명이 없는 비율(0, 0.5, 1). */
+    public double darkTerm(boolean litU, boolean litV) {
+        return ((litU ? 0 : 1) + (litV ? 0 : 1)) / 2.0;
+    }
+
+    /** 물가 항 f_w: 두 끝 노드 중 해안·하천에서 50 m 밖인 비율(0, 0.5, 1). */
+    public double inlandTerm(double waterU, double waterV) {
+        return ((waterU > waterNearMeters ? 1 : 0) + (waterV > waterNearMeters ? 1 : 0)) / 2.0;
+    }
+
     /**
      * 구간 (u,v)의 선호 비용 p(u,v) (단위 m).
-     * p = ℓ·(α_s f_s + α_f f_f) + α_c·κ_c·1[v가 신호 교차로]
+     * p = ℓ·(α_s f_s + α_f f_f) + α_c·κ_c·1[v가 신호 교차로]   (조명·물가 항 없음, 기존과 같음)
      */
     public double edgeCost(double length, double elevU, double elevV, double facU, double facV, boolean signalV) {
+        return edgeCost(length, elevU, elevV, facU, facV, signalV, true, true, 0.0, 0.0);
+    }
+
+    /** p = ℓ·(α_s f_s + α_f f_f + α_l f_l + α_w f_w) + α_c·κ_c·1[v가 신호 교차로] */
+    public double edgeCost(double length, double elevU, double elevV, double facU, double facV, boolean signalV,
+                           boolean litU, boolean litV, double waterU, double waterV) {
         double perLength = alphaS * slopeTerm(length, elevU, elevV) + alphaF * facilityTerm(facU, facV);
+        if (alphaL != 0.0) perLength += alphaL * darkTerm(litU, litV);
+        if (alphaW != 0.0) perLength += alphaW * inlandTerm(waterU, waterV);
         return length * perLength + (signalV ? alphaC * signalPassMeters : 0.0);
     }
 }
diff --git a/src/main/java/com/gildongmu/application/dto/RouteRecommendRequest.java b/src/main/java/com/gildongmu/application/dto/RouteRecommendRequest.java
