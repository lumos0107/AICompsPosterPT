@@ -21,6 +21,9 @@ public class RouteRecommendRequest {
     private Double alphaS;
     private Double alphaC;
     private Double alphaF;
+    // 2026-11-10 밤 추가(선택): 조명 α_l, 물가 α_w. 없으면 0.
+    private Double alphaL;
+    private Double alphaW;
     // 러닝 동선 모양(선택, LOOP_V2 귀환에서만): 근접 벌점 반경(m)·크기, 회전 1회 비용(m)·각도(도, 기본 45). 없으면 0(기존과 같음).
     private Double shapeProxRadius;
     private Double shapeProxGamma;
diff --git a/src/main/java/com/gildongmu/application/service/RouteService.java b/src/main/java/com/gildongmu/application/service/RouteService.java
index 5fad0ae..90b3027 100644
--- a/src/main/java/com/gildongmu/application/service/RouteService.java
+++ b/src/main/java/com/gildongmu/application/service/RouteService.java
@@ -40,11 +40,14 @@ public class RouteService {
 
     /** 요청에 α 값이 하나라도 있으면 선호 비용 방식(빈 값은 0), 없으면 null(기존 방식). */
     static com.gildongmu.algorithm.loopv2.Preference preferenceOf(RouteRecommendRequest req) {
-        if (req.getAlphaS() == null && req.getAlphaC() == null && req.getAlphaF() == null) return null;
+        if (req.getAlphaS() == null && req.getAlphaC() == null && req.getAlphaF() == null
+            && req.getAlphaL() == null && req.getAlphaW() == null) return null;
         return com.gildongmu.algorithm.loopv2.Preference.of(
             req.getAlphaS() == null ? 0.0 : req.getAlphaS(),
             req.getAlphaC() == null ? 0.0 : req.getAlphaC(),
-            req.getAlphaF() == null ? 0.0 : req.getAlphaF());
+            req.getAlphaF() == null ? 0.0 : req.getAlphaF(),
+            req.getAlphaL() == null ? 0.0 : req.getAlphaL(),
+            req.getAlphaW() == null ? 0.0 : req.getAlphaW());
     }
 
     /** 요청의 모양 값(없으면 0) → RouteShape. 모두 0이면 NONE(기존 귀환과 같음). */
diff --git a/src/test/java/com/gildongmu/algorithm/loopv2/PreferenceTest.java b/src/test/java/com/gildongmu/algorithm/loopv2/PreferenceTest.java
index 7a4175c..e4aa905 100644
--- a/src/test/java/com/gildongmu/algorithm/loopv2/PreferenceTest.java
+++ b/src/test/java/com/gildongmu/algorithm/loopv2/PreferenceTest.java
@@ -47,4 +47,20 @@ class PreferenceTest {
         assertEquals(0.0, p.facilityTerm(0, 0), 1e-12);
         assertEquals(0.3, p.facilityTerm(100, 200), 1e-12);
     }
+
+    @Test
+    void 조명_물가_항은_어둡거나_물가에서_먼_구간에_길이_비례_비용을_준다() {
+        Preference p = Preference.of(0, 0, 0, 2.0, 3.0);
+        // 100 m 구간: 두 끝 모두 조명 있음, 물가 30 m 안 → 비용 0
+        assertEquals(0.0, p.edgeCost(100, 0, 0, 500, 500, false, true, true, 30, 30), 1e-9);
+        // 한 끝만 어두움(0.5), 두 끝 모두 물가 밖(1) → 100·(2·0.5 + 3·1) = 400
+        assertEquals(400.0, p.edgeCost(100, 0, 0, 500, 500, false, true, false, 80, 300), 1e-9);
+    }
+
+    @Test
+    void 조명_물가_선호가_0이면_기존_비용과_같다() {
+        Preference p = Preference.of(1, 1, 1);
+        assertEquals(p.edgeCost(100, 0, 6, 200, 400, true),
+                     p.edgeCost(100, 0, 6, 200, 400, true, false, false, 400, 400), 1e-12);
+    }
 }
