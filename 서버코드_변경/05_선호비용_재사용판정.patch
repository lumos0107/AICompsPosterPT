diff --git a/src/test/java/com/gildongmu/algorithm/loopv2/PreferenceTest.java b/src/test/java/com/gildongmu/algorithm/loopv2/PreferenceTest.java
new file mode 100644
index 0000000..7a4175c
--- /dev/null
+++ b/src/test/java/com/gildongmu/algorithm/loopv2/PreferenceTest.java
@@ -0,0 +1,50 @@
+package com.gildongmu.algorithm.loopv2;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class PreferenceTest {
+
+    @Test
+    void 선호가_모두_0이면_비용은_0이다() {
+        Preference p = Preference.of(0, 0, 0);
+        assertEquals(0.0, p.edgeCost(30, 10, 20, 400, 450, true), 1e-12);
+    }
+
+    @Test
+    void 경사_항은_임계값까지_0이고_20퍼센트포인트_위에서_1이다() {
+        Preference p = Preference.of(1, 0, 0);   // τ = 2%
+        assertEquals(0.0, p.slopeTerm(100, 0, 2), 1e-12);       // 2%
+        assertEquals(0.25, p.slopeTerm(100, 0, 7), 1e-12);      // 7% → (7−2)/20
+        assertEquals(1.0, p.slopeTerm(100, 0, 40), 1e-12);      // 상한
+        assertEquals(p.slopeTerm(100, 0, 7), p.slopeTerm(100, 7, 0), 1e-12);  // 오르막·내리막 같음
+    }
+
+    @Test
+    void 같은_구간을_나눠도_길이_비례_비용은_같다() {
+        // 계획서 2장 2항: 다른 간격으로 나눠도 비용이 크게 달라지지 않아야 한다.
+        Preference p = Preference.of(1, 0, 1);
+        double whole = p.edgeCost(60, 0, 6, 200, 200, false);                 // 60 m, 10%
+        double halves = p.edgeCost(30, 0, 3, 200, 200, false) + p.edgeCost(30, 3, 6, 200, 200, false);
+        double thirds = 3 * p.edgeCost(20, 0, 2, 200, 200, false);
+        assertEquals(whole, halves, 1e-9);
+        assertEquals(whole, thirds, 1e-9);
+    }
+
+    @Test
+    void 신호_교차로_비용은_통과_1회당이고_길이와_무관하다() {
+        Preference p = Preference.of(0, 1, 0);
+        assertEquals(Preference.SIGNAL_PASS_METERS, p.edgeCost(5, 0, 0, 500, 500, true), 1e-12);
+        assertEquals(Preference.SIGNAL_PASS_METERS, p.edgeCost(80, 0, 0, 500, 500, true), 1e-12);
+        assertEquals(0.0, p.edgeCost(80, 0, 0, 500, 500, false), 1e-12);
+    }
+
+    @Test
+    void 편의시설_항은_500m에서_잘리고_가까울수록_작다() {
+        Preference p = Preference.of(0, 0, 1);
+        assertEquals(1.0, p.facilityTerm(800, 600), 1e-12);
+        assertEquals(0.0, p.facilityTerm(0, 0), 1e-12);
+        assertEquals(0.3, p.facilityTerm(100, 200), 1e-12);
+    }
+}
