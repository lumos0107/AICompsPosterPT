+            .edge(2, 4, 90).edge(4, 5, 80).edge(5, 0, 90);
+        Preference pref = Preference.of(0, 1, 0);
+        ReturnPlanner.Graph g = new ReturnPlanner.Graph() {
+            @Override public List<Integer> neighbors(int id) { return base.neighbors(id); }
+            @Override public double length(int a, int b) { return base.length(a, b); }
+            @Override public double straightDistance(int a, int b) { return 0.0; }
+            @Override public double prefCost(int a, int b) { return pref.edgeCost(length(a, b), 0, 0, 500, 500, b == 3); }
+        };
+        ReturnPlanner.Result withPref = new ReturnPlanner(g, 5.0, 10_000.0).plan(List.of(0, 1, 2), 460.0, 0.10, 3);
+        ReturnPlanner.Result noPref = new ReturnPlanner(base, 5.0, 10_000.0).plan(List.of(0, 1, 2), 460.0, 0.10, 3);
+
+        assertNotNull(withPref);
+        assertEquals(List.of(0, 1, 2, 4, 5, 0), withPref.loop());
+        assertEquals(460.0, withPref.length(), 1e-6);     // 길이는 비용이 아니라 실제 길이
+        assertNotNull(noPref);
+        assertEquals(List.of(0, 1, 2, 3, 0), noPref.loop());  // 선호가 없으면 짧은 길(기존 동작)
+    }
 }
