@@ -0,0 +1,74 @@
+package com.gildongmu.algorithm.loopv2;
+
+import com.gildongmu.algorithm.ScoreCalculator;
+import com.gildongmu.database.entity.JejuRoadPoint;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ReuseTailTest {
+
+    static JejuRoadPoint pt(int id, double lat, double lng) throws Exception {
+        JejuRoadPoint p = new JejuRoadPoint();
+        for (String[] f : new String[][]{{"pointId", null}, {"latitude", null}, {"longitude", null}}) {
+            Field fd = JejuRoadPoint.class.getDeclaredField(f[0]);
+            fd.setAccessible(true);
+            fd.set(p, f[0].equals("pointId") ? (Object) id : f[0].equals("latitude") ? (Object) lat : (Object) lng);
+        }
+        return p;
+    }
+
+    /** 위도 방향으로 약 15 m 간격의 일직선 경로. */
+    static List<JejuRoadPoint> line(int n) throws Exception {
+        List<JejuRoadPoint> r = new ArrayList<>();
+        for (int i = 0; i < n; i++) r.add(pt(i, 33.5 + i * 15.0 / 111000.0, 126.5));
+        return r;
+    }
+
+    @Test
+    void 최근_100m_안의_점_수를_센다() throws Exception {
+        // 15 m 간격: 현재 점 포함 0,15,...,90 m → 7개
+        assertEquals(7, LoopV2Engine.recentTail(line(20), 100.0));
+        assertEquals(3, LoopV2Engine.recentTail(line(3), 100.0));
+        assertEquals(0, LoopV2Engine.recentTail(new ArrayList<>(), 100.0));
+    }
+
+    @Test
+    void 최근_경로를_빼면_직진할_때_재사용_벌점이_없다() throws Exception {
+        List<JejuRoadPoint> route = line(20);
+        List<double[]> visited = new ArrayList<>();
+        for (JejuRoadPoint p : route) visited.add(new double[]{p.getLatitude(), p.getLongitude()});
+        JejuRoadPoint cur = route.get(19);
+        JejuRoadPoint cand = pt(99, cur.getLatitude() + 15.0 / 111000.0, 126.5);
+        double old = ScoreCalculator.calculate(cur.getLatitude(), cur.getLongitude(), 0, cand, 0, 8,
+            33.5, 126.5, 33.6, 126.5, 300, 3000, List.of(), List.of(), visited, false);
+        double fixed = ScoreCalculator.calculate(cur.getLatitude(), cur.getLongitude(), 0, cand, 0, 8,
+            33.5, 126.5, 33.6, 126.5, 300, 3000, List.of(), List.of(), visited, false,
+            LoopV2Engine.recentTail(route, 100.0));
+        double same = ScoreCalculator.calculate(cur.getLatitude(), cur.getLongitude(), 0, cand, 0, 8,
+            33.5, 126.5, 33.6, 126.5, 300, 3000, List.of(), List.of(), visited, false, 0);
+        assertEquals(old, same, 1e-12);          // 인자 0이면 기존과 같다
+        assertTrue(fixed > old, "기존 판정은 방금 지나온 점 때문에 직진에도 벌점을 준다");
+    }
+
+    @Test
+    void 최근_경로를_빼도_예전에_지난_곳으로_돌아오면_벌점이_남는다() throws Exception {
+        List<JejuRoadPoint> route = line(20);   // 0~285 m
+        List<double[]> visited = new ArrayList<>();
+        for (JejuRoadPoint p : route) visited.add(new double[]{p.getLatitude(), p.getLongitude()});
+        JejuRoadPoint cur = route.get(19);
+        JejuRoadPoint candBack = route.get(2);   // 30 m 지점(이미 지난 곳) 근처로 가는 후보
+        double fixedBack = ScoreCalculator.calculate(cur.getLatitude(), cur.getLongitude(), 0, candBack, 0, 8,
+            33.5, 126.5, 33.6, 126.5, 300, 3000, List.of(), List.of(), visited, false,
+            LoopV2Engine.recentTail(route, 100.0));
+        JejuRoadPoint candFwd = pt(98, cur.getLatitude() + 15.0 / 111000.0, 126.5);
+        double fixedFwd = ScoreCalculator.calculate(cur.getLatitude(), cur.getLongitude(), 0, candFwd, 0, 8,
+            33.5, 126.5, 33.6, 126.5, 300, 3000, List.of(), List.of(), visited, false,
+            LoopV2Engine.recentTail(route, 100.0));
+        assertTrue(fixedBack < fixedFwd);
+    }
+}
