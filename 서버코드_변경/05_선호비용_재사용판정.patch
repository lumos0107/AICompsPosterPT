new file mode 100644
index 0000000..74bdb38
--- /dev/null
+++ b/src/main/java/com/gildongmu/algorithm/loopv2/NodeAttributes.java
@@ -0,0 +1,74 @@
+/*
+ * NodeAttributes (정보기술학회 실험, 2026-11-10)
+ * - 노드별 신호 교차로 여부와 가장 가까운 편의시설까지 거리(m)를 파일에서 읽는다.
+ * - 설정 gildongmu.node-attr-file 이 비어 있으면 모든 노드가 신호 아님, 시설 거리 상한(500 m)으로 본다.
+ * - 파일 형식(CSV, 머리줄 있음): point_id,signal,facility_m   (signal은 0/1)
+ * - DB 표 구조를 바꾸지 않으려고 파일로 둔다(기존 DB로 표 2를 재현할 때 영향 없음).
+ */
+package com.gildongmu.algorithm.loopv2;
+
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+@Slf4j
+@Component
+public class NodeAttributes {
+
+    private final Set<Integer> signals = new HashSet<>();
+    private final Map<Integer, Double> facility = new HashMap<>();
+    private final boolean loaded;
+
+    public NodeAttributes(@Value("${gildongmu.node-attr-file:}") String file) {
+        this.loaded = file != null && !file.isBlank();
+        if (loaded) {
+            read(Path.of(file));
+            log.info("[노드 속성] {} 읽음: 노드 {}개, 신호 교차로 {}개", file, facility.size(), signals.size());
+        }
+    }
+
+    NodeAttributes(Set<Integer> signals, Map<Integer, Double> facility) {
+        this.loaded = true;
+        this.signals.addAll(signals);
+        this.facility.putAll(facility);
+    }
+
+    public boolean isLoaded() {
+        return loaded;
+    }
+
+    public boolean isSignal(int pointId) {
+        return signals.contains(pointId);
+    }
+
+    public double facilityMeters(int pointId) {
+        return facility.getOrDefault(pointId, Preference.FACILITY_CAP_METERS);
+    }
+
+    private void read(Path p) {
+        try {
+            List<String> lines = Files.readAllLines(p, StandardCharsets.UTF_8);
+            for (int i = 1; i < lines.size(); i++) {
+                String t = lines.get(i).strip();
+                if (t.isEmpty()) continue;
+                String[] v = t.split(",");
+                int id = Integer.parseInt(v[0].strip());
+                if ("1".equals(v[1].strip())) signals.add(id);
+                facility.put(id, Double.parseDouble(v[2].strip()));
+            }
+        } catch (IOException e) {
+            throw new UncheckedIOException("노드 속성 파일을 읽지 못함: " + p, e);
+        }
+    }
+}
diff --git a/src/main/java/com/gildongmu/algorithm/loopv2/Preference.java b/src/main/java/com/gildongmu/algorithm/loopv2/Preference.java
new file mode 100644
index 0000000..656fdfa
--- /dev/null
+++ b/src/main/java/com/gildongmu/algorithm/loopv2/Preference.java
@@ -0,0 +1,52 @@
+/*
+ * Preference (정보기술학회 실험, 2026-11-10)
+ * - 러너 선호 α = (α_s 경사, α_c 신호 교차로, α_f 편의시설). 0이면 그 선호를 고려하지 않는다.
+ * - 계획서 2장의 비용 단위:
+ *     경사·편의시설 = 구간 길이에 비례, 신호 교차로 = 통과 1회당(길이 곱과 분리).
+ * - 아래 상수는 잠정값이다. 계획서 3장 나 '세 선호 값' 점검(예비 경로)에서 크기를 보고 조정한다.
+ */
+package com.gildongmu.algorithm.loopv2;
+
+public record Preference(double alphaS, double alphaC, double alphaF,
+                         double tauPercent, double signalPassMeters, double facilityCapMeters,
+                         double lambdaP, double stepMeters, double reuseRecentMeters) {
+
+    /** 경사 면제 임계값 τ(%) 잠정값. */
+    public static final double TAU_PERCENT = 2.0;
+    /** 신호 교차로 1회 통과 비용을 길이로 환산한 값(m) 잠정값. α_c=1이면 신호 하나 = 100 m 우회와 같다. */
+    public static final double SIGNAL_PASS_METERS = 100.0;
+    /** 편의시설 거리 상한(m). 초안 표 1과 같다. */
+    public static final double FACILITY_CAP_METERS = 500.0;
+    /** 나가는 구간 점수에서 선호 비용의 무게 λ_p 잠정값. */
+    public static final double LAMBDA_P = 1.0;
+    /** 나가는 구간 점수에서 비용(m)을 점수로 바꿀 기준 길이(m). 노드 간격 15 m와 같게 둔다. */
+    public static final double STEP_METERS = 15.0;
+    /** 재사용 판정에서 뺄 최근 경로 길이(m). 지나온 길 중 이 길이 안의 점은 '재사용'으로 세지 않는다. */
+    public static final double REUSE_RECENT_METERS = 100.0;
+
+    public static Preference of(double alphaS, double alphaC, double alphaF) {
+        return new Preference(alphaS, alphaC, alphaF, TAU_PERCENT, SIGNAL_PASS_METERS, FACILITY_CAP_METERS,
+            LAMBDA_P, STEP_METERS, REUSE_RECENT_METERS);
+    }
+
+    /** 경사 항 f_s: min(1, max(0, |g| − τ) / 20), g = 구간 경사(%). */
+    public double slopeTerm(double length, double elevU, double elevV) {
+        if (length <= 0) return 0.0;
+        double g = Math.abs(100.0 * (elevV - elevU) / length);
+        return Math.min(1.0, Math.max(0.0, g - tauPercent) / 20.0);
+    }
+
+    /** 편의시설 항 f_f: 두 끝 노드의 min(d, 500)/500 평균. */
+    public double facilityTerm(double facU, double facV) {
+        return (Math.min(facU, facilityCapMeters) + Math.min(facV, facilityCapMeters)) / 2.0 / facilityCapMeters;
+    }
+
+    /**
+     * 구간 (u,v)의 선호 비용 p(u,v) (단위 m).
+     * p = ℓ·(α_s f_s + α_f f_f) + α_c·κ_c·1[v가 신호 교차로]
+     */
+    public double edgeCost(double length, double elevU, double elevV, double facU, double facV, boolean signalV) {
+        double perLength = alphaS * slopeTerm(length, elevU, elevV) + alphaF * facilityTerm(facU, facV);
+        return length * perLength + (signalV ? alphaC * signalPassMeters : 0.0);
+    }
+}
