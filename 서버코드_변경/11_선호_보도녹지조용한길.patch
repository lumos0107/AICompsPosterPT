@@ -24,6 +24,8 @@ public class RouteRecommendRequest {
     // 2026-11-10 밤 추가(선택): 조명 α_l, 물가 α_w. 없으면 0.
     private Double alphaL;
     private Double alphaW;
+    // 이름 있는 성질 선호(선택): 예 {"sidewalk": 3, "green": 3, "quiet": 3}. 노드 속성 파일의 같은 이름 열을 쓴다.
+    private java.util.Map<String, Double> alphaFlags;
     // 러닝 동선 모양(선택, LOOP_V2 귀환에서만): 근접 벌점 반경(m)·크기, 회전 1회 비용(m)·각도(도, 기본 45). 없으면 0(기존과 같음).
     private Double shapeProxRadius;
     private Double shapeProxGamma;
diff --git a/src/main/java/com/gildongmu/application/service/RouteService.java b/src/main/java/com/gildongmu/application/service/RouteService.java
index 90b3027..93774b2 100644
--- a/src/main/java/com/gildongmu/application/service/RouteService.java
+++ b/src/main/java/com/gildongmu/application/service/RouteService.java
@@ -41,13 +41,13 @@ public class RouteService {
     /** 요청에 α 값이 하나라도 있으면 선호 비용 방식(빈 값은 0), 없으면 null(기존 방식). */
     static com.gildongmu.algorithm.loopv2.Preference preferenceOf(RouteRecommendRequest req) {
         if (req.getAlphaS() == null && req.getAlphaC() == null && req.getAlphaF() == null
-            && req.getAlphaL() == null && req.getAlphaW() == null) return null;
+            && req.getAlphaL() == null && req.getAlphaW() == null && req.getAlphaFlags() == null) return null;
         return com.gildongmu.algorithm.loopv2.Preference.of(
             req.getAlphaS() == null ? 0.0 : req.getAlphaS(),
             req.getAlphaC() == null ? 0.0 : req.getAlphaC(),
             req.getAlphaF() == null ? 0.0 : req.getAlphaF(),
             req.getAlphaL() == null ? 0.0 : req.getAlphaL(),
-            req.getAlphaW() == null ? 0.0 : req.getAlphaW());
+            req.getAlphaW() == null ? 0.0 : req.getAlphaW()).withFlags(req.getAlphaFlags());
     }
 
     /** 요청의 모양 값(없으면 0) → RouteShape. 모두 0이면 NONE(기존 귀환과 같음). */
