diff --git a/src/main/java/com/gildongmu/algorithm/loopv2/LoopV2Engine.java b/src/main/java/com/gildongmu/algorithm/loopv2/LoopV2Engine.java
index 3b6d911..32376f6 100644
--- a/src/main/java/com/gildongmu/algorithm/loopv2/LoopV2Engine.java
+++ b/src/main/java/com/gildongmu/algorithm/loopv2/LoopV2Engine.java
@@ -205,7 +205,18 @@ public class LoopV2Engine {
         double ev = v.getElevationMeters() == null ? eu : v.getElevationMeters();
         return pref.edgeCost(len, eu, ev, attrs.facilityMeters(u.getPointId()), attrs.facilityMeters(v.getPointId()),
             attrs.isSignal(v.getPointId()), attrs.isLit(u.getPointId()), attrs.isLit(v.getPointId()),
-            attrs.waterMeters(u.getPointId()), attrs.waterMeters(v.getPointId()));
+            attrs.waterMeters(u.getPointId()), attrs.waterMeters(v.getPointId()))
+            + flagCost(u, v, len, pref);
+    }
+
+    /** 이름 있는 성질 선호의 비용: Σ_f α_f · ℓ · (성질 없는 끝점 비율). */
+    private double flagCost(JejuRoadPoint u, JejuRoadPoint v, double len, Preference pref) {
+        double c = 0.0;
+        for (Map.Entry<String, Double> f : pref.flagAlpha().entrySet()) {
+            if (f.getValue() == 0.0) continue;
+            c += f.getValue() * len * Preference.lackingTerm(attrs.has(f.getKey(), u.getPointId()), attrs.has(f.getKey(), v.getPointId()));
+        }
+        return c;
     }
 
     /** 방문 목록 끝에서부터 경로 길이 limit(m) 안에 드는 점의 개수(현재 노드 포함). */
diff --git a/src/main/java/com/gildongmu/algorithm/loopv2/NodeAttributes.java b/src/main/java/com/gildongmu/algorithm/loopv2/NodeAttributes.java
index 95e854b..43626f7 100644
--- a/src/main/java/com/gildongmu/algorithm/loopv2/NodeAttributes.java
+++ b/src/main/java/com/gildongmu/algorithm/loopv2/NodeAttributes.java
@@ -32,6 +32,8 @@ public class NodeAttributes {
     // 2026-11-10 밤 추가(선택 열): lit(25 m 안 조명 0/1), water_m(해안·하천까지 m). 열이 없으면 조명 있음·물가로 보아 비용 0.
     private final Set<Integer> dark = new HashSet<>();
     private final Map<Integer, Double> water = new HashMap<>();
+    // 6번째 열부터(선택): 이름 있는 0/1 성질(예: sidewalk, green, quiet). 값이 0인 노드만 모아 둔다. 열이 없으면 모두 1로 본다.
+    private final Map<String, Set<Integer>> lacking = new HashMap<>();
     private final boolean loaded;
 
     @Autowired   // 테스트용 생성자가 따로 있어 Spring이 쓸 생성자를 지정
@@ -71,9 +73,17 @@ public class NodeAttributes {
         return water.getOrDefault(pointId, 0.0);
     }
 
+    /** 이름 있는 성질(sidewalk, green, quiet 등)을 노드가 가지면 true. 그런 열이 없으면 true. */
+    public boolean has(String flag, int pointId) {
+        Set<Integer> s = lacking.get(flag);
+        return s == null || !s.contains(pointId);
+    }
+
     private void read(Path p) {
         try {
             List<String> lines = Files.readAllLines(p, StandardCharsets.UTF_8);
+            String[] head = lines.isEmpty() ? new String[0] : lines.get(0).strip().split(",");
+            for (int c = 5; c < head.length; c++) lacking.put(head[c].strip(), new HashSet<>());
             for (int i = 1; i < lines.size(); i++) {
                 String t = lines.get(i).strip();
                 if (t.isEmpty()) continue;
@@ -83,6 +93,9 @@ public class NodeAttributes {
                 facility.put(id, Double.parseDouble(v[2].strip()));
                 if (v.length > 3 && "0".equals(v[3].strip())) dark.add(id);
                 if (v.length > 4) water.put(id, Double.parseDouble(v[4].strip()));
+                for (int c = 5; c < Math.min(v.length, head.length); c++) {
+                    if ("0".equals(v[c].strip())) lacking.get(head[c].strip()).add(id);
+                }
             }
         } catch (IOException e) {
             throw new UncheckedIOException("노드 속성 파일을 읽지 못함: " + p, e);
diff --git a/src/main/java/com/gildongmu/algorithm/loopv2/Preference.java b/src/main/java/com/gildongmu/algorithm/loopv2/Preference.java
index 844e9e9..d9a96cb 100644
--- a/src/main/java/com/gildongmu/algorithm/loopv2/Preference.java
+++ b/src/main/java/com/gildongmu/algorithm/loopv2/Preference.java
@@ -12,7 +12,8 @@ package com.gildongmu.algorithm.loopv2;
 public record Preference(double alphaS, double alphaC, double alphaF,
                          double tauPercent, double signalPassMeters, double facilityCapMeters,
                          double lambdaP, double stepMeters, double reuseRecentMeters,
-                         double alphaL, double alphaW, double waterNearMeters) {
+                         double alphaL, double alphaW, double waterNearMeters,
+                         java.util.Map<String, Double> flagAlpha) {
 
     /** 경사 면제 임계값 τ(%) 확정값. */
     public static final double TAU_PERCENT = 2.0;
@@ -35,7 +36,22 @@ public record Preference(double alphaS, double alphaC, double alphaF,
 
     public static Preference of(double alphaS, double alphaC, double alphaF, double alphaL, double alphaW) {
         return new Preference(alphaS, alphaC, alphaF, TAU_PERCENT, SIGNAL_PASS_METERS, FACILITY_CAP_METERS,
-            LAMBDA_P, STEP_METERS, REUSE_RECENT_METERS, alphaL, alphaW, WATER_NEAR_METERS);
+            LAMBDA_P, STEP_METERS, REUSE_RECENT_METERS, alphaL, alphaW, WATER_NEAR_METERS, java.util.Map.of());
+    }
+
+    /**
+     * 이름 있는 0/1 성질(예: sidewalk 보도, green 녹지, quiet 조용한 길)의 선호를 더한 사본(2026-11-10 밤).
+     * 성질이 없는 끝점 비율 × 길이 × α_f 를 비용에 더한다. 0이거나 빈 맵이면 기존과 같다.
+     */
+    public Preference withFlags(java.util.Map<String, Double> flags) {
+        return new Preference(alphaS, alphaC, alphaF, tauPercent, signalPassMeters, facilityCapMeters,
+            lambdaP, stepMeters, reuseRecentMeters, alphaL, alphaW, waterNearMeters,
+            flags == null ? java.util.Map.of() : java.util.Map.copyOf(flags));
+    }
+
+    /** 성질 항: 두 끝 노드 중 그 성질이 없는 비율(0, 0.5, 1). */
+    public static double lackingTerm(boolean hasU, boolean hasV) {
+        return ((hasU ? 0 : 1) + (hasV ? 0 : 1)) / 2.0;
     }
 
     /** 경사 항 f_s: min(1, max(0, |g| − τ) / 20), g = 구간 경사(%). */
diff --git a/src/main/java/com/gildongmu/application/dto/RouteRecommendRequest.java b/src/main/java/com/gildongmu/application/dto/RouteRecommendRequest.java
index bd5af23..e4a5c97 100644
