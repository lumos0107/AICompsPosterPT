diff --git a/src/main/java/com/gildongmu/algorithm/loopv2/ReturnPlanner.java b/src/main/java/com/gildongmu/algorithm/loopv2/ReturnPlanner.java
new file mode 100644
index 0000000..11b9688
--- /dev/null
+++ b/src/main/java/com/gildongmu/algorithm/loopv2/ReturnPlanner.java
@@ -0,0 +1,159 @@
+/*
+ * ReturnPlanner (LOOP_V2)
+ * - 외향 경로(출발점 s에서 시작하는 노드열)가 주어지면, 그 위의 반환점 k를 골라 s까지 돌아오는 귀환 경로를 붙여
+ *   닫힌 순환 경로를 만든다.
+ * - 귀환 = s에서 출발하는 다익스트라(무방향 그래프). 간선 비용 = 길이 × (1 + γ·[외향 간선과 같은 무방향 간선]).
+ *   외향 재사용은 금지가 아니라 비용으로 처리(막다른 길·다리처럼 다른 길이 없으면 되밟기 허용).
+ * - 반환점 선택: 외향 전체를 벌점 집합으로 한 1회 탐색으로 모든 k의 근사 길이를 구해 목표에 가까운 상위 후보를 추린 뒤,
+ *   후보마다 '선택한 접두 구간(0..k)'만 벌점으로 다시 탐색해 실제 길이·되밟기를 계산한다.
+ * - 길이는 가중 비용이 아니라 간선 실제 길이의 합으로 계산한다.
+ * - 도로망·DB와 무관한 순수 계산 클래스(Graph 인터페이스로 주입) → 작은 가상 그래프로 단위 테스트.
+ */
+package com.gildongmu.algorithm.loopv2;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.PriorityQueue;
+import java.util.Set;
+
+public final class ReturnPlanner {
+
+    public interface Graph {
+        List<Integer> neighbors(int id);
+        /** 인접한 두 노드 사이 실제 길이(m). */
+        double length(int a, int b);
+        /** 두 노드 사이 직선거리(m). 탐색 반경 제한에만 쓴다. */
+        double straightDistance(int a, int b);
+    }
+
+    /**
+     * @param k              반환점의 외향 경로 인덱스
+     * @param loop           s → ... → out[k] → (귀환) → s
+     * @param length         폐합 경로 실제 길이(m)
+     * @param retraceLength  귀환 경로 중 선택한 외향 접두 구간과 같은 무방향 간선의 길이 합(m)
+     * @param withinTolerance |length − target| ≤ tolerance·target
+     */
+    public record Result(int k, List<Integer> loop, double length, double retraceLength,
+                         boolean withinTolerance, double outboundLength, double returnLength) {}
+
+    private final Graph graph;
+    private final double gamma;
+    private final double radiusMeters;
+
+    public ReturnPlanner(Graph graph, double gamma, double radiusMeters) {
+        this.graph = graph;
+        this.gamma = gamma;
+        this.radiusMeters = radiusMeters;
+    }
+
+    public Result plan(List<Integer> outbound, double target, double toleranceRatio, int refineTop) {
+        if (outbound == null || outbound.size() < 2) return null;
+        int s = outbound.get(0);
+        int n = outbound.size();
+        double[] prefix = new double[n];
+        for (int i = 1; i < n; i++) prefix[i] = prefix[i - 1] + graph.length(outbound.get(i - 1), outbound.get(i));
+
+        // 1) 외향 전체를 벌점 집합으로 한 근사 탐색 → 목표에 가까운 반환점 후보 추리기
+        Search all = search(s, edgeKeys(outbound, n - 1));
+        List<int[]> ranked = new ArrayList<>();   // [k]
+        List<Double> gaps = new ArrayList<>();
+        for (int k = 1; k < n; k++) {
+            Double back = all.real.get(outbound.get(k));
+            if (back == null || outbound.get(k) == s) continue;
+            ranked.add(new int[]{k});
+            gaps.add(Math.abs(prefix[k] + back - target));
+        }
+        if (ranked.isEmpty()) return null;
+        List<Integer> order = new ArrayList<>();
+        for (int i = 0; i < ranked.size(); i++) order.add(i);
+        order.sort(Comparator.comparingDouble(gaps::get));
+
+        // 2) 후보마다 선택한 접두 구간만 벌점으로 다시 탐색해 실제 길이·되밟기 계산
+        Result best = null;
+        for (int i = 0; i < Math.min(refineTop, order.size()); i++) {
+            int k = ranked.get(order.get(i))[0];
+            Set<Long> prefixKeys = edgeKeys(outbound, k);
+            Search sk = search(s, prefixKeys);
+            int node = outbound.get(k);
+            if (!sk.real.containsKey(node)) continue;
+
+            List<Integer> ret = new ArrayList<>();
+            for (Integer cur = node; cur != null; cur = sk.parent.get(cur)) ret.add(cur);
+            double retLen = 0, retrace = 0;
+            for (int j = 1; j < ret.size(); j++) {
+                double len = graph.length(ret.get(j - 1), ret.get(j));
+                retLen += len;
+                if (prefixKeys.contains(key(ret.get(j - 1), ret.get(j)))) retrace += len;
+            }
+            List<Integer> loop = new ArrayList<>(outbound.subList(0, k + 1));
+            loop.addAll(ret.subList(1, ret.size()));
+            double length = prefix[k] + retLen;
+            boolean within = Math.abs(length - target) <= toleranceRatio * target;
+            Result r = new Result(k, loop, length, retrace, within, prefix[k], retLen);
+            if (best == null || better(r, best, target)) best = r;
+        }
+        return best;
+    }
+
+    /** 허용범위 안을 우선, 그 안에서는 되밟기 적은 쪽, 같으면 목표에 가까운 쪽. 밖이면 목표에 가까운 쪽. */
+    private static boolean better(Result a, Result b, double target) {
+        if (a.withinTolerance() != b.withinTolerance()) return a.withinTolerance();
+        double ga = Math.abs(a.length() - target), gb = Math.abs(b.length() - target);
+        if (a.withinTolerance()) {
+            if (Math.abs(a.retraceLength() - b.retraceLength()) > 1e-9) return a.retraceLength() < b.retraceLength();
+            return ga < gb;
+        }
+        if (Math.abs(ga - gb) > 1e-9) return ga < gb;
+        return a.retraceLength() < b.retraceLength();
+    }
+
+    private static final class Search {
+        final Map<Integer, Double> cost = new HashMap<>();
+        final Map<Integer, Double> real = new HashMap<>();
+        final Map<Integer, Integer> parent = new HashMap<>();
+    }
+
+    private Search search(int s, Set<Long> penalized) {
+        Search r = new Search();
+        r.cost.put(s, 0.0);
+        r.real.put(s, 0.0);
+        PriorityQueue<double[]> pq = new PriorityQueue<>(Comparator.comparingDouble(a -> a[0]));
+        pq.add(new double[]{0.0, s});
+        Set<Integer> done = new HashSet<>();
+        while (!pq.isEmpty()) {
+            double[] top = pq.poll();
+            int u = (int) top[1];
+            if (!done.add(u)) continue;
+            for (int v : graph.neighbors(u)) {
+                if (done.contains(v)) continue;
+                if (graph.straightDistance(s, v) > radiusMeters) continue;
+                double len = graph.length(u, v);
+                double c = len * (1.0 + (penalized.contains(key(u, v)) ? gamma : 0.0));
+                double nc = top[0] + c;
+                Double old = r.cost.get(v);
+                if (old == null || nc < old - 1e-12) {
+                    r.cost.put(v, nc);
+                    r.real.put(v, r.real.get(u) + len);
+                    r.parent.put(v, u);
+                    pq.add(new double[]{nc, v});
+                }
+            }
+        }
+        return r;
+    }
+
+    private static Set<Long> edgeKeys(List<Integer> path, int lastIndex) {
+        Set<Long> keys = new HashSet<>();
+        for (int i = 1; i <= lastIndex; i++) keys.add(key(path.get(i - 1), path.get(i)));
+        return keys;
+    }
+
+    static long key(int a, int b) {
+        int lo = Math.min(a, b), hi = Math.max(a, b);
+        return ((long) lo << 32) | (hi & 0xffffffffL);
+    }
+}
diff --git a/src/test/java/com/gildongmu/algorithm/loopv2/ReturnPlannerTest.java b/src/test/java/com/gildongmu/algorithm/loopv2/ReturnPlannerTest.java
new file mode 100644
index 0000000..5acc672
--- /dev/null
+++ b/src/test/java/com/gildongmu/algorithm/loopv2/ReturnPlannerTest.java
@@ -0,0 +1,107 @@
+package com.gildongmu.algorithm.loopv2;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ReturnPlannerTest {
+
+    /** 엣지 길이를 직접 지정하는 테스트용 무방향 그래프(좌표는 반경 제한 판정용으로 모두 같은 점). */
+    static class TestGraph implements ReturnPlanner.Graph {
+        final Map<Integer, Map<Integer, Double>> adj = new HashMap<>();
+
+        TestGraph edge(int a, int b, double len) {
+            adj.computeIfAbsent(a, k -> new HashMap<>()).put(b, len);
+            adj.computeIfAbsent(b, k -> new HashMap<>()).put(a, len);
+            return this;
+        }
+
+        @Override public List<Integer> neighbors(int id) { return new ArrayList<>(adj.getOrDefault(id, Map.of()).keySet()); }
+        @Override public double length(int a, int b) { return adj.get(a).get(b); }
+        @Override public double straightDistance(int a, int b) { return 0.0; }
+    }
+
+    private static TestGraph ring(int n, double len) {
+        TestGraph g = new TestGraph();
+        for (int i = 0; i < n; i++) g.edge(i, (i + 1) % n, len);
+        return g;
+    }
+
+    @Test
+    void 다른_길이_있으면_온_길을_되밟지_않고_닫힌다() {
+        // 8각 고리, 한 변 100 m. 외향 0→4(400 m), 목표 800 m → 반대쪽 4→5→6→7→0 으로 귀환해야 함.
+        ReturnPlanner planner = new ReturnPlanner(ring(8, 100.0), 5.0, 10_000.0);
+        ReturnPlanner.Result r = planner.plan(List.of(0, 1, 2, 3, 4), 800.0, 0.10, 3);
+
+        assertNotNull(r);
+        assertEquals(List.of(0, 1, 2, 3, 4, 5, 6, 7, 0), r.loop());
+        assertEquals(800.0, r.length(), 1e-6);
+        assertEquals(0.0, r.retraceLength(), 1e-6);
+        assertTrue(r.withinTolerance());
+    }
+
+    @Test
+    void 막다른_길이면_되밟기가_불가피해도_출발점으로_닫힌다() {
+        // 0-1-2-3 일직선(다리·막다른 길). 귀환은 같은 길뿐.
+        TestGraph g = new TestGraph().edge(0, 1, 100).edge(1, 2, 100).edge(2, 3, 100);
+        ReturnPlanner.Result r = new ReturnPlanner(g, 5.0, 10_000.0).plan(List.of(0, 1, 2, 3), 600.0, 0.10, 3);
+
+        assertNotNull(r);
+        assertEquals(0, r.loop().get(r.loop().size() - 1));
+        assertEquals(600.0, r.length(), 1e-6);
+        assertEquals(300.0, r.retraceLength(), 1e-6);
+    }
+
+    @Test
+    void 경로_길이는_가중비용이_아니라_실제_거리로_계산한다() {
+        // A쪽 0-1-2-3 (변 100 m, 외향), B쪽 3-4-5-0 (변 400 m). γ=2 → A 귀환 비용 900 < B 1200 이라 A로 귀환.
+        // 실제 길이는 외향 300 + 귀환 300 = 600 (가중 비용 900을 더하면 안 됨).
+        TestGraph g = new TestGraph().edge(0, 1, 100).edge(1, 2, 100).edge(2, 3, 100)
+                                     .edge(3, 4, 400).edge(4, 5, 400).edge(5, 0, 400);
+        ReturnPlanner.Result r = new ReturnPlanner(g, 2.0, 10_000.0).plan(List.of(0, 1, 2, 3), 600.0, 0.10, 3);
+
+        assertNotNull(r);
+        assertEquals(600.0, r.length(), 1e-6);
+        assertEquals(List.of(0, 1, 2, 3, 2, 1, 0), r.loop());
+    }
+
+    @Test
+    void 목표거리에_맞는_중간_반환점을_고르고_길이를_다시_계산한다() {
+        // 일직선 0-1-2-3-4-5(변 100 m) + 2에서 0으로 돌아가는 우회로 2-6-0(변 100 m).
+        // 목표 400 m → k=2 에서 우회로로 귀환(0-1-2-6-0, 400 m, 되밟기 0)이 최선.
+        TestGraph g = new TestGraph().edge(0, 1, 100).edge(1, 2, 100).edge(2, 3, 100).edge(3, 4, 100).edge(4, 5, 100)
+                                     .edge(2, 6, 100).edge(6, 0, 100);
+        ReturnPlanner.Result r = new ReturnPlanner(g, 5.0, 10_000.0).plan(List.of(0, 1, 2, 3, 4, 5), 400.0, 0.10, 3);
+
+        assertNotNull(r);
+        assertEquals(2, r.k());
+        assertEquals(List.of(0, 1, 2, 6, 0), r.loop());
+        assertEquals(400.0, r.length(), 1e-6);
+        assertEquals(0.0, r.retraceLength(), 1e-6);
+    }
+
+    @Test
+    void 목표거리_허용범위를_못_맞추면_실패로_표시한다() {
+        // 고리 전체가 800 m뿐인데 목표 3000 m → 닫힌 경로는 만들되 허용범위 밖으로 표시.
+        ReturnPlanner.Result r = new ReturnPlanner(ring(8, 100.0), 5.0, 10_000.0).plan(List.of(0, 1, 2, 3, 4), 3000.0, 0.10, 3);
+
+        assertNotNull(r);
+        assertFalse(r.withinTolerance());
+        assertEquals(0, r.loop().get(r.loop().size() - 1));
+    }
+
+    @Test
+    void 재사용_벌점이_0이면_비용이_같을_때도_닫힌_경로를_만든다() {
+        // γ=0 대조군: 양쪽 귀환 비용이 같음 → 어느 쪽이든 닫히고 길이 800.
+        ReturnPlanner.Result r = new ReturnPlanner(ring(8, 100.0), 0.0, 10_000.0).plan(List.of(0, 1, 2, 3, 4), 800.0, 0.10, 3);
+
+        assertNotNull(r);
+        assertEquals(0, r.loop().get(r.loop().size() - 1));
+        assertEquals(800.0, r.length(), 1e-6);
+    }
+}
