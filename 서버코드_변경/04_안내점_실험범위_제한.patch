diff --git a/src/main/java/com/gildongmu/algorithm/loopv2/ExperimentArea.java b/src/main/java/com/gildongmu/algorithm/loopv2/ExperimentArea.java
new file mode 100644
index 0000000..0f9a550
--- /dev/null
+++ b/src/main/java/com/gildongmu/algorithm/loopv2/ExperimentArea.java
@@ -0,0 +1,79 @@
+/*
+ * ExperimentArea
+ * - 실험 범위(1:1,000 도엽 칸 목록)를 담는다. 도엽은 경위도 0.005도 칸이고, 칸 번호는 (floor(경도/0.005), floor(위도/0.005)).
+ * - 범위 밖은 신호 자료가 없어 신호를 피하는 경로가 밖으로 쏠리므로, 안내점은 범위 안에서만 고른다(2026-11-10 사용자 지시).
+ * - 설정 gildongmu.experiment-area-file 이 비어 있으면 제한 없음(기존 동작과 같음).
+ * - 파일 형식: 한 줄에 "경도칸,위도칸" 정수 두 개. '#'로 시작하는 줄과 빈 줄은 무시.
+ */
+package com.gildongmu.algorithm.loopv2;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+@Component
+public class ExperimentArea {
+
+    static final double STEP = 0.005;
+
+    private final Set<Long> cells;   // null이면 제한 없음
+
+    public ExperimentArea(@Value("${gildongmu.experiment-area-file:}") String file) {
+        this.cells = (file == null || file.isBlank()) ? null : read(Path.of(file));
+    }
+
+    ExperimentArea(Set<Long> cells) {
+        this.cells = cells;
+    }
+
+    static ExperimentArea unrestricted() {
+        return new ExperimentArea((Set<Long>) null);
+    }
+
+    static ExperimentArea ofCells(List<int[]> lonLatCells) {
+        Set<Long> s = new HashSet<>();
+        for (int[] c : lonLatCells) s.add(key(c[0], c[1]));
+        return new ExperimentArea(s);
+    }
+
+    public boolean isRestricted() {
+        return cells != null;
+    }
+
+    public int size() {
+        return cells == null ? 0 : cells.size();
+    }
+
+    public boolean contains(double lat, double lng) {
+        if (cells == null) return true;
+        return cells.contains(key((int) Math.floor(lng / STEP), (int) Math.floor(lat / STEP)));
+    }
+
+    private static long key(int lonCell, int latCell) {
+        return ((long) lonCell << 32) | (latCell & 0xffffffffL);
+    }
+
+    private static Set<Long> read(Path p) {
+        try {
+            Set<Long> s = new HashSet<>();
+            for (String line : Files.readAllLines(p, StandardCharsets.UTF_8)) {
+                String t = line.strip();
+                if (t.isEmpty() || t.startsWith("#")) continue;
+                String[] v = t.split(",");
+                s.add(key(Integer.parseInt(v[0].strip()), Integer.parseInt(v[1].strip())));
+            }
+            if (s.isEmpty()) throw new IllegalStateException("실험 범위 파일에 칸이 없음: " + p);
+            return s;
+        } catch (IOException e) {
+            throw new UncheckedIOException("실험 범위 파일을 읽지 못함: " + p, e);
+        }
+    }
+}
diff --git a/src/main/java/com/gildongmu/algorithm/loopv2/LoopV2Engine.java b/src/main/java/com/gildongmu/algorithm/loopv2/LoopV2Engine.java
