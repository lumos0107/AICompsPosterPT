+package com.gildongmu.algorithm.loopv2;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ExperimentAreaTest {
+
+    /** 경도 126.480~126.550, 위도 33.480~33.515 (14x7칸) 사각형. */
+    private static ExperimentArea box() {
+        List<int[]> c = new ArrayList<>();
+        for (int i = 25296; i <= 25309; i++) for (int j = 6696; j <= 6702; j++) c.add(new int[]{i, j});
+        return ExperimentArea.ofCells(c);
+    }
+
+    @Test
+    void 설정이_없으면_제한하지_않는다() {
+        ExperimentArea a = new ExperimentArea("");
+        assertFalse(a.isRestricted());
+        assertTrue(a.contains(0.0, 0.0));
+        assertEquals(16, LoopV2Engine.anchorDirections(33.5, 126.5, 1140, a).size());
+    }
+
+    @Test
+    void 칸_경계로_안팎을_가른다() {
+        ExperimentArea a = box();
+        assertTrue(a.contains(33.5149, 126.522));
+        assertFalse(a.contains(33.5151, 126.522));   // 북쪽 경계 밖
+        assertFalse(a.contains(33.50, 126.4799));    // 서쪽 경계 밖
+        assertTrue(a.contains(33.4801, 126.5499));
+    }
+
+    @Test
+    void 범위_가운데서는_16방향이_모두_남는다() {
+        // 제주종합경기장 근처, 3km 요청의 안내 거리 1,140m
+        assertEquals(16, LoopV2Engine.anchorDirections(33.4925, 126.5105, 1140, box()).size());
+    }
+
+    @Test
+    void 북쪽_경계_근처에서는_북쪽_방향이_빠진다() {
+        // 탑동 노드(33.51469, 126.52173), 3km
+        List<double[]> d = LoopV2Engine.anchorDirections(33.51469, 126.52173, 1140, box());
+        assertTrue(d.size() < 16);
+        for (double[] x : d) {
+            assertTrue(x[1] < 33.515, "남은 방향의 목표점은 범위 안이어야 함");
+        }
+        assertTrue(d.stream().noneMatch(x -> x[0] == 0.0), "정북(0번) 방향은 빠져야 함");
+    }
+
+    @Test
+    void 파일에서_칸을_읽는다(@TempDir Path dir) throws Exception {
+        Path f = dir.resolve("area.txt");
+        Files.writeString(f, "# 경도칸,위도칸\n25304,6702\n\n25305, 6702\n");
+        ExperimentArea a = new ExperimentArea(f.toString());
+        assertTrue(a.isRestricted());
+        assertEquals(2, a.size());
+        assertTrue(a.contains(33.512, 126.522));   // 25304 = 126.520~126.525
+        assertFalse(a.contains(33.512, 126.517));
+    }
+}
