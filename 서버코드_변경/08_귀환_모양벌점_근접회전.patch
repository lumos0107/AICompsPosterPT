+    /**
+     * 간선 단위 다익스트라(회전 벌점). 상태 = (직전 노드, 현재 노드). 방위가 turnAngleDeg보다 크게 바뀌면 turnCostMeters를 더한다.
+     * 방위가 대칭이므로 s에서 거꾸로 탐색해도 실제 귀환 방향의 회전 수와 같다.
+     */
+    private Search searchWithTurns(int s, Set<Long> penalized, Set<Integer> near) {
+        final long START = Long.MIN_VALUE;
+        Map<Long, Double> cost = new HashMap<>();
+        Map<Long, Double> real = new HashMap<>();
+        Map<Long, Long> parent = new HashMap<>();
+        Map<Integer, Long> bestState = new HashMap<>();   // 노드별 가장 싼 도착 상태
+        Map<Integer, Double> bestCost = new HashMap<>();
+        cost.put(START, 0.0);
+        real.put(START, 0.0);
+        bestState.put(s, START);
+        bestCost.put(s, 0.0);
+        PriorityQueue<Object[]> pq = new PriorityQueue<>(Comparator.comparingDouble(a -> (Double) a[0]));
+        pq.add(new Object[]{0.0, START, -1, s});
+        Set<Long> done = new HashSet<>();
+        while (!pq.isEmpty()) {
+            Object[] top = pq.poll();
+            double c0 = (Double) top[0];
+            long st = (Long) top[1];
+            int prev = (Integer) top[2];
+            int u = (Integer) top[3];
+            if (!done.add(st)) continue;
+            for (int v : graph.neighbors(u)) {
+                if (v == prev) continue;
+                if (graph.straightDistance(s, v) > radiusMeters) continue;
+                long ns = dkey(u, v);
+                if (done.contains(ns)) continue;
+                double len = graph.length(u, v);
+                double c = edgeCost(u, v, len, penalized, near);
+                if (prev >= 0 && isTurn(prev, u, v)) c += shape.turnCostMeters();
+                double nc = c0 + c;
+                Double old = cost.get(ns);
+                if (old == null || nc < old - 1e-12) {
+                    cost.put(ns, nc);
+                    real.put(ns, real.get(st) + len);
+                    parent.put(ns, st);
+                    pq.add(new Object[]{nc, ns, u, v});
+                    Double bc = bestCost.get(v);
+                    if (bc == null || nc < bc - 1e-12) { bestCost.put(v, nc); bestState.put(v, ns); }
+                }
+            }
+        }
+        return new Search() {
+            @Override public Double real(int node) {
+                Long st = bestState.get(node);
+                return st == null ? null : real.get(st);
+            }
+            @Override public List<Integer> pathFrom(int node) {
+                List<Integer> out = new ArrayList<>();
+                Long st = bestState.get(node);
+                while (st != null && st != START) {
+                    out.add((int) (st & 0xffffffffL));
+                    st = parent.get(st);
+                }
+                out.add(s);
+                return out;
+            }
+        };
+    }
+
+    private boolean isTurn(int a, int b, int c) {
+        double h1 = graph.bearing(a, b), h2 = graph.bearing(b, c);
+        if (Double.isNaN(h1) || Double.isNaN(h2)) return false;
+        double d = Math.abs(((h2 - h1) % 360 + 540) % 360 - 180);
+        return d > shape.turnAngleDeg();
+    }
+
+    /** 외향 접두 노드(0..lastIndex)에서 도로 거리 proxRadiusMeters 안의 노드(근접 벌점을 안 쓰면 null). */
+    private Set<Integer> near(List<Integer> path, int lastIndex) {
+        if (!shape.usesProximity()) return null;
+        Map<Integer, Double> dist = new HashMap<>();
+        PriorityQueue<double[]> pq = new PriorityQueue<>(Comparator.comparingDouble(a -> a[0]));
+        for (int i = 0; i <= lastIndex; i++) {
+            dist.put(path.get(i), 0.0);
+            pq.add(new double[]{0.0, path.get(i)});
+        }
+        Set<Integer> done = new HashSet<>();
+        while (!pq.isEmpty()) {
+            double[] top = pq.poll();
+            int u = (int) top[1];
+            if (!done.add(u)) continue;
+            for (int v : graph.neighbors(u)) {
+                double nd = top[0] + graph.length(u, v);
+                if (nd > shape.proxRadiusMeters()) continue;
+                Double old = dist.get(v);
+                if (old == null || nd < old) { dist.put(v, nd); pq.add(new double[]{nd, v}); }
+            }
+        }
+        return done;
+    }
+
+    /** 방향 있는 간선 키(a→b). */
+    private static long dkey(int a, int b) {
+        return ((long) a << 32) | (b & 0xffffffffL);
     }
 
     private static Set<Long> edgeKeys(List<Integer> path, int lastIndex) {
