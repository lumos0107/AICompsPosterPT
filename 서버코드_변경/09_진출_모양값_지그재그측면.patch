 /*
  * RouteShape (정보기술학회 실험, 2026-11-10 밤 추가)
- * - 러닝 동선 기준(Gemsa 외 2013: 모양·회전 복잡도, Hänsel 외 2025: 불필요한 회전 회피)을 돌아오는 구간 비용에 넣는 값.
+ * - 러닝 동선 기준(Gemsa 외 2013: 모양·회전 복잡도, Hänsel 외 2025: 불필요한 회전 회피)을 경로 비용·점수에 넣는 값.
+ * 돌아오는 구간(ReturnPlanner)
  * - proxRadiusMeters, proxGamma: 선택한 외향 접두 구간에서 도로 거리 proxRadiusMeters 안의 간선(두 끝 모두 안)에
  *   길이 × proxGamma 벌점. 바로 옆 평행 도로로 돌아와 고리가 가늘어지는 것을 막는다.
  * - turnCostMeters, turnAngleDeg: 돌아오는 구간에서 진행 방위가 turnAngleDeg보다 크게 바뀔 때마다 turnCostMeters(m) 벌점.
- * - 모두 0이면 기존 귀환과 같다(NONE).
+ * 나가는 구간(LoopV2Engine.buildCandidates)
+ * - zigzagScale: 기존 지그재그 벌점(w9)에 곱하는 배율. 1이면 기존과 같다.
+ * - lateralWeight: 출발점→안내점 축에서 빔의 방위 오프셋 쪽(+는 오른쪽, −는 왼쪽)으로 벌어질수록 주는 점수의 무게.
+ *   오프셋 0인 빔에는 주지 않는다. 0이면 기존과 같다.
+ * - 모두 기본값이면 기존과 같다(NONE).
  */
 package com.gildongmu.algorithm.loopv2;
 
-public record RouteShape(double proxRadiusMeters, double proxGamma, double turnCostMeters, double turnAngleDeg) {
+public record RouteShape(double proxRadiusMeters, double proxGamma, double turnCostMeters, double turnAngleDeg,
+                         double zigzagScale, double lateralWeight) {
 
-    public static final RouteShape NONE = new RouteShape(0.0, 0.0, 0.0, 45.0);
+    public static final RouteShape NONE = new RouteShape(0.0, 0.0, 0.0, 45.0, 1.0, 0.0);
+
+    /** 돌아오는 구간 값만 정할 때(나가는 구간은 기존과 같음). */
+    public static RouteShape returnOnly(double proxRadiusMeters, double proxGamma, double turnCostMeters, double turnAngleDeg) {
+        return new RouteShape(proxRadiusMeters, proxGamma, turnCostMeters, turnAngleDeg, 1.0, 0.0);
+    }
 
     public boolean usesProximity() { return proxRadiusMeters > 0 && proxGamma > 0; }
 
     public boolean usesTurns() { return turnCostMeters > 0; }
+
+    public boolean changesOutbound() { return zigzagScale != 1.0 || lateralWeight != 0.0; }
+
+    /**
+     * 측면 분리 점수: 출발점 s→안내점 g 축에 대해 후보 c가 빔 오프셋 쪽으로 벌어진 정도 sin(각) ∈ [−1, 1].
+     * 오프셋이 +(시계 방향, 오른쪽)이면 오른쪽일수록, −이면 왼쪽일수록 크다. 오프셋이 없거나 0이면 0.
+     */
+    public static double lateral(double sLat, double sLng, double gLat, double gLng, double cLat, double cLng, Double offset) {
+        if (offset == null || offset == 0.0) return 0.0;
+        double k = Math.cos(Math.toRadians(sLat));
+        double ax = (gLng - sLng) * k, ay = gLat - sLat;
+        double cx = (cLng - sLng) * k, cy = cLat - sLat;
+        double am = Math.hypot(ax, ay), cm = Math.hypot(cx, cy);
+        if (am == 0 || cm == 0) return 0.0;
+        double sinLeft = (ax * cy - ay * cx) / (am * cm);   // > 0 이면 축의 왼쪽
+        return offset > 0 ? -sinLeft : sinLeft;
+    }
 }
