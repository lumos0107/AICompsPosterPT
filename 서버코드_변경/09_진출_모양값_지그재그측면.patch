+package com.gildongmu.algorithm.loopv2;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class RouteShapeTest {
+
+    // 출발점 (33.5, 126.5), 안내점은 정북쪽. 동쪽 후보 = 축의 오른쪽, 서쪽 후보 = 왼쪽.
+    private static final double S_LAT = 33.5, S_LNG = 126.5, G_LAT = 33.51, G_LNG = 126.5;
+
+    @Test
+    void 오른쪽_빔은_축의_오른쪽으로_벌어질수록_점수가_크다() {
+        double east = RouteShape.lateral(S_LAT, S_LNG, G_LAT, G_LNG, 33.505, 126.505, 23.0);
+        double west = RouteShape.lateral(S_LAT, S_LNG, G_LAT, G_LNG, 33.505, 126.495, 23.0);
+        assertTrue(east > 0);
+        assertTrue(west < 0);
+    }
+
+    @Test
+    void 왼쪽_빔은_축의_왼쪽으로_벌어질수록_점수가_크다() {
+        double east = RouteShape.lateral(S_LAT, S_LNG, G_LAT, G_LNG, 33.505, 126.505, -23.0);
+        double west = RouteShape.lateral(S_LAT, S_LNG, G_LAT, G_LNG, 33.505, 126.495, -23.0);
+        assertTrue(west > 0);
+        assertTrue(east < 0);
+    }
+
+    @Test
+    void 가운데_빔과_축_위_후보는_0이고_기본값은_나가는_구간을_바꾸지_않는다() {
+        assertEquals(0.0, RouteShape.lateral(S_LAT, S_LNG, G_LAT, G_LNG, 33.505, 126.505, 0.0));
+        assertEquals(0.0, RouteShape.lateral(S_LAT, S_LNG, G_LAT, G_LNG, 33.505, 126.5, 23.0), 1e-9);
+        assertFalse(RouteShape.NONE.changesOutbound());
+        assertFalse(RouteShape.returnOnly(100, 3, 60, 45).changesOutbound());
+    }
+}
