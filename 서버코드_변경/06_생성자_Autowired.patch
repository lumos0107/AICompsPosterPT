 package com.gildongmu.algorithm.loopv2;
 
+import org.springframework.beans.factory.annotation.Autowired;
 import org.springframework.beans.factory.annotation.Value;
 import org.springframework.stereotype.Component;
 
@@ -26,6 +27,7 @@ public class ExperimentArea {
 
     private final Set<Long> cells;   // null이면 제한 없음
 
+    @Autowired   // 테스트용 생성자가 따로 있어 Spring이 쓸 생성자를 지정
     public ExperimentArea(@Value("${gildongmu.experiment-area-file:}") String file) {
         this.cells = (file == null || file.isBlank()) ? null : read(Path.of(file));
     }
